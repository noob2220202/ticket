PORT=9000
NODE_ENV=production

# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# Set to true only once the site is served over HTTPS (e.g. behind an nginx
# reverse proxy with a valid certificate). If true while serving plain HTTP,
# the session cookie will not be sent and login will appear to silently fail.
COOKIE_SECURE=false
