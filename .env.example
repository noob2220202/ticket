PORT=9000
NODE_ENV=production

# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# Set to true only once the site is actually served over HTTPS. If true while
# serving plain HTTP, the session cookie will not be sent and login will
# appear to silently fail.
COOKIE_SECURE=false

# Optional: paths to a TLS certificate + private key. When both are set and
# readable, the server listens with HTTPS directly on PORT (no reverse proxy
# needed). Leave both unset to serve plain HTTP (e.g. local development).
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain/privkey.pem
