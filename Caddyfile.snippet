# 복드림 상품권 - Caddy 리버스 프록시 설정
# /etc/caddy/Caddyfile 에 아래 블록들을 추가한 뒤 reload 하세요.
# (Cloudflare 프록시는 회색 구름(DNS only)이어야 Caddy가 인증서를 자동 발급합니다.)

# 사이트 1: 대표자 김상현
bokdreamticket.store {
    reverse_proxy 127.0.0.1:9011
}

# 사이트 2: 대표자 양동헌
ticketbokdream.shop {
    reverse_proxy 127.0.0.1:9015
}

# 사이트 3: 대표자 김상현 (한글 도메인 복드림.store)
xn--hy1bm6gx4c.store {
    reverse_proxy 127.0.0.1:9016
}

# 사이트 4: 대표자 박성현 (전화번호 미노출)
bokdreamticket.shop {
    reverse_proxy 127.0.0.1:9017
}

# 사이트 5: 대표자 황보경애
bokdream.store {
    reverse_proxy 127.0.0.1:9018
}

# 사이트 6: 대표자 이승우
bokdream1.store {
    reverse_proxy 127.0.0.1:9019
}

# 사이트 7: 대표자 하석태 (bokdreamticket.store의 서브도메인)
1.bokdreamticket.store {
    reverse_proxy 127.0.0.1:9020
}

# 사이트 8: 대표자 김택현 (bokdreamticket.store의 서브도메인)
2.bokdreamticket.store {
    reverse_proxy 127.0.0.1:9021
}

# 사이트 9: 대표자 조광연 (bokdreamticket.store의 서브도메인)
4.bokdreamticket.store {
    reverse_proxy 127.0.0.1:9022
}

# 사이트 10: 대표자 양정수 (bokdreamticket.store의 서브도메인)
5.bokdreamticket.store {
    reverse_proxy 127.0.0.1:9023
}

# 사이트 11: 대표자 정대원
ticketbokdream.store {
    reverse_proxy 127.0.0.1:9024
}

# 사이트 12: 대표자 양정수
bok-dreamticket.store {
    reverse_proxy 127.0.0.1:9025
}

# 사이트 13: 대표자 김민정 (Cloudflare 없이 도메인 등록업체 DNS에서 A 레코드로 직접 연결)
bokdream-ticket.shop {
    reverse_proxy 127.0.0.1:9026
}

# 사이트 14: 대표자 이승진 (bokdream.store의 서브도메인)
no1.bokdream.store {
    reverse_proxy 127.0.0.1:9027
}

# 사이트 15: 대표자 정연재
bok-dream.store {
    reverse_proxy 127.0.0.1:9029
}

# 사이트 16: TM 상품권 (대표자 장규원)
tm-ticket.store {
    reverse_proxy 127.0.0.1:9030
}

# 사이트 17: (주)에스에스에프앤비 (대표자 최봄, ticketbokdream.shop의 서브도메인)
no1.ticketbokdream.shop {
    reverse_proxy 127.0.0.1:9031
}
